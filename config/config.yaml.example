# Application Settings
app:
  name: "SQLatte"
  version: "0.6.1"
  host: "0.0.0.0"
  port: 8002

# Analytics Database Configuration
analytics:
  enabled: true
  backend: "postgresql"
  postgresql:
    host: "${ANALYTICS_DB_HOST:localhost}"
    port: 5432
    database: "${ANALYTICS_DB_NAME:sqlatte_analytics}"
    user: "${ANALYTICS_DB_USER:sqlatte}"
    password: "${ANALYTICS_DB_PASSWORD}"

config_db:
  enabled: true
  type: postgresql

  postgresql:
    host: "${CONFIG_DB_HOST:localhost}"
    database: "${CONFIG_DB_NAME:sqlatte_config}"
    user: "${CONFIG_DB_USER:sqlatte}"
    password: "${CONFIG_DB_PASSWORD}"

  # Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
  encryption_key: "${CONFIG_DB_ENCRYPTION_KEY}"

admin:
  enabled: true
  username: "${ADMIN_USERNAME:admin}"
  password: "${ADMIN_PASSWORD}"

# ============================================
# LDAP AUTHENTICATION (optional)
# ============================================
# Disabled by default. When enabled, used by:
#   - Admin login (tried first, falls back to admin.username/password above)
#   - The SQLatte Assistant login gate (see plugins.assistant_login below)
#
# Pick ONE bind mode:
#   1. Direct bind — set user_dn_template, no service account needed:
#        user_dn_template: "uid={username},ou=people,dc=example,dc=com"
#   2. Search+bind — set bind_dn/bind_password (service account) + base_dn:
#        bind_dn: "cn=svc-sqlatte,dc=example,dc=com"
#        bind_password: "${LDAP_BIND_PASSWORD}"
#        base_dn: "dc=example,dc=com"
#        user_search_filter: "(uid={username})"   # or "(sAMAccountName={username})" for AD
ldap:
  enabled: false
  server: "${LDAP_SERVER:ldaps://ldap.example.com:636}"
  use_ssl: true
  connect_timeout: 5
  # user_dn_template: "uid={username},ou=people,dc=example,dc=com"
  # bind_dn: "${LDAP_BIND_DN}"
  # bind_password: "${LDAP_BIND_PASSWORD}"
  # base_dn: "${LDAP_BASE_DN}"
  # user_search_filter: "(uid={username})"
  #
  # Optional: restrict login to members of a single LDAP group. A successful
  # bind is not enough on its own once this is set.
  # required_group_dn: "cn=sqlatte-users,ou=groups,dc=example,dc=com"
  # group_member_attr: "member"   # "member" (default, OpenLDAP groupOfNames) | "memberOf" (AD) | "memberUid" (POSIX groups)
  # Only used for group_member_attr: memberOf when user_dn_template doesn't
  # produce a real DN (e.g. AD down-level logon names "DOMAIN\{username}"):
  # group_lookup_filter: "(sAMAccountName={username})"   # default; e.g. "(uid={username})" for non-AD directories

# ============================================
# AUTHENTICATION PLUGIN
# ============================================
plugins:
  auth:
    enabled: true
    session_ttl_minutes: 480
    max_workers: 40

    db_provider: "trino"
    db_host: "${TRINO_HOST}"
    db_port: 443

    allowed_catalogs:
      - name: "s3_access_logs"
        allowed_schemas: [ "web" ]
      - name: "s3_geoip"
        allowed_schemas: [ "cloudflare" ]
      - name: "mongo_stores_db"
        allowed_schemas: [ "stores" ]
      - name: "mongo_common_db"
        allowed_schemas: [ "conversationalsearch" ]
      - name: "mysql_app_db"
        allowed_schemas: [ "app" ]

    allowed_db_types:
      - "trino"

  # Optional LDAP login gate for the SQLatte Assistant (the legacy /query
  # widget in frontend/index.html), which otherwise has no login at all.
  # Requires ldap.enabled: true above. Enabling this also implies
  # query.require_session — see src/api/app.py's /query handler.
  assistant_login:
    enabled: false
    ttl_hours: 8   # session lifetime after a successful LDAP login

# ============================================
# LLM Provider
# ============================================
llm:
  #provider: "gemini"
  #provider: "anthropic"
  provider: "vertexai"

  anthropic:
    api_key: "${ANTHROPIC_API_KEY}"
    model: "claude-sonnet-4-20250514"
    max_tokens: 1000

  gemini:
    api_key: "${GEMINI_API_KEY}"
    model: "gemini-pro"
    max_tokens: 1000

  vertexai:
    project_id: "${VERTEXAI_PROJECT_ID}"
    location: "${VERTEXAI_LOCATION:europe-west1}"
    model: "gemini-2.5-pro"
    model_routing:
      intent_detection: "gemini-2.5-flash"
      chat: "gemini-2.5-flash"
      sql: "gemini-2.5-pro"
      insights: "gemini-2.5-flash"
      ops_insights: "gemini-2.5-flash"
    max_tokens: 1000
    # Path to service account JSON key file
    credentials_path: "${GOOGLE_APPLICATION_CREDENTIALS}"
    # Or paste JSON content directly (for containers):
    # credentials_json: "${VERTEXAI_CREDENTIALS_JSON}"

# ============================================
# Database Providers
# ============================================
database:
  provider: "trino"

  trino:
    host: "${TRINO_HOST}"
    port: 443
    user: "${TRINO_USER}"
    password: "${TRINO_PASSWORD}"
    catalog: "${TRINO_CATALOG:s3_edr_accesslog}"
    schema: "${TRINO_SCHEMA:edr}"
    http_scheme: "https"

  postgresql:
    host: "${POSTGRES_HOST}"
    port: 5432
    database: "${POSTGRES_DB}"
    user: "${POSTGRES_USER}"
    password: "${POSTGRES_PASSWORD}"
    schema: "${POSTGRES_SCHEMA:public}"
    min_connections: 1
    max_connections: 10

  mysql:
    host: "${MYSQL_HOST}"
    port: 3306
    database: "${MYSQL_DB}"
    user: "${MYSQL_USER}"
    password: "${MYSQL_PASSWORD}"
    autocommit: true

  bigquery:
    project_id: "${BQ_PROJECT_ID}"
    dataset: ""
    location: "US"
    credentials_path: "${GOOGLE_APPLICATION_CREDENTIALS}"
    credentials_json: ""
    timeout: 300
    max_results: 10000

# CORS Settings
cors:
  allow_origins: ["*"]
  allow_credentials: true
  allow_methods: ["*"]
  allow_headers: ["*"]

# Query Settings
query:
  default_limit: 100
  max_limit: 1000
  timeout: 300

# ============================================
# Scheduler & Email
# ============================================
scheduler:
  enabled: true
  timezone: "UTC"
  max_concurrent_jobs: 10
  job_timeout_seconds: 300
  keep_history_days: 30
  max_executions_per_schedule: 100

email:
  enabled: true
  provider: "smtp"
  smtp:
    host: "${SMTP_HOST}"
    port: 25
    user: "${SMTP_USER:}"
    password: "${SMTP_PASSWORD:}"
    from_email: "${SMTP_FROM_EMAIL}"
    from_name: "SQLatte Reports"
  templates:
    success_subject: "✅ {{schedule_name}} - {{date}}"
    failure_subject: "❌ Failed: {{schedule_name}}"
  max_emails_per_day: 1000
  max_recipients_per_email: 10

export:
  formats:
    - csv
    - excel
    - html
  max_rows: 10000
  max_file_size_mb: 25
  filename_template: "{{schedule_name}}_{{date}}_{{time}}.{{format}}"

# ═══════════════════════════════════════════════════
# BigQuery Ops Agent
# ═══════════════════════════════════════════════════
ops_agent:
  enabled: true
  ai_insights: true
  ai_insights_max: 5
  provider: "bigquery_ops"
  config:
    projects:
      - project_id: "${BQ_OPS_PROJECT_ID}"
        region: "${BQ_OPS_REGION:europe-west1}"
        credentials_path: "${BQ_OPS_CREDENTIALS_PATH}"
      # Add more projects as needed:
      # - project_id: "${BQ_OPS_PROJECT_ID_2}"
      #   region: "europe-west1"
      #   credentials_path: "${BQ_OPS_CREDENTIALS_PATH_2}"
    allowed_operations:
      - get_expensive_queries
      - forecast_monthly_costs
      - get_time_travel_consumers
      - analyze_storage_compression
      - identify_large_unpartitioned_tables
      - get_on_demand_vs_flat_rate_analysis
      - find_public_datasets
      - check_table_permissions
      - audit_service_account_usage
      - get_slow_queries
      - analyze_data_skew
      - check_slot_saturation
      - get_partition_recommendations
      - get_query_errors
      - find_full_table_scans
      - find_unused_tables
      - get_recent_table_users

# ============================================
# OPS Alarms
# ============================================
alarms:
  enabled: true
  storage_path: "config/alarms.json"
  default_recipients:
    - "${ALARM_DEFAULT_RECIPIENT}"

jira:
  enabled: true
  url: "${JIRA_URL}"
  email: "${JIRA_EMAIL}"
  api_token: "${JIRA_API_TOKEN}"
  project_key: "${JIRA_PROJECT_KEY:DATA}"
  issue_type: "Bug"
  priority: "High"

# ============================================
# UI Section Visibility
# ============================================
ui:
  sections:
    assistant: true
    demo: true
    analytics: false
    schedules: true
    dashboards: true
    bigquery_ops: true
    admin: true
    tokens: true

insights:
  enabled: true
  mode: hybrid
  max_insights: 3
  include_statistical: true

rate_limiting:
  enabled: false
  strategy: sliding_window
  key_type: session_id
  requests_per_window: 30
  window_seconds: 60
  protected_paths:
    - "/query"
    - "/auth/query"
  exclude_paths:
    - "/health"
    - "/static"
    - "/admin"

mcp:
  sse:
    enabled: false   # set true to expose /mcp/sse for network MCP clients

  # Security alerts: notify when an AI/MCP-generated query looks sensitive.
  # Fires on either trigger — a risk_score above the threshold, or the query
  # referencing a column matching an enabled MCP Masking field_pattern.
  # Disabled by default; every check is best-effort and never blocks the query.
  security_alerts:
    enabled: false
    risk_threshold: 70       # 0-100, see sql_validator.risk_score()
    apply_to: ["mcp"]        # which widget_type values to alert on
    notify_emails: []        # requires email.enabled: true; always logs regardless

# ============================================
# PROMPTS CONFIGURATION
# ============================================
prompts:
  intent_detection: |
    Analyze this user question and determine if it requires a SQL query or is general conversation.

    Available Tables Schema:
    {schema_info}
    1
    User Question: {question}

    Rules:
    1. If question asks about data, analytics, or queries related to the available tables → intent: "sql"
    2. If question is greeting, general chat, help, or unrelated to tables → intent: "chat"
    3. If tables are not selected but question seems like SQL query → intent: "chat" (explain they need to select tables)

    Respond in this exact format:
    INTENT: sql or chat
    CONFIDENCE: 0.0 to 1.0
    REASONING: brief explanation

  barista_personality: |
    You are SQLatte ☕ - a friendly AI assistant that helps users query their databases with natural language.

    Your personality:
    - Helpful and friendly, like a barista serving the perfect drink
    - Knowledgeable about SQL and databases
    - Can have casual conversations too
    - Use coffee/brewing metaphors occasionally when appropriate

    When users ask general questions (not about data):
    - Respond naturally and helpfully
    - If they seem lost, guide them on how to use SQLatte
    - Be concise but friendly

  sql_generation: |
    You are a SQL expert. Generate a SQL query based on the user's question.

    Table Schema(s):
    {schema_info}

    User Question: {question}

    Rules:
    1. Generate ONLY valid SQL syntax for trino
    2. If multiple tables are provided, use appropriate JOINs
    3. Infer JOIN conditions from table relationships (common column names)
    4. Use table aliases for readability (e.g., orders o, customers c)
    5. Include LIMIT clause for safety (default 100 rows)
    6. For aggregations, use GROUP BY appropriately
    7. Use explicit JOIN syntax (INNER JOIN, LEFT JOIN, etc.)

    ⚡ PERFORMANCE OPTIMIZATION (CRITICAL):
    8. **PARTITION COLUMN**: If schema contains a 'dt' column (VARCHAR format YYYYMMDD, e.g., '20251218'), this is a PARTITION KEY
       - ALWAYS add WHERE clause with 'dt' filter when possible
       - Date filters MUST use dt column in format: dt = '20251218' or dt BETWEEN '20251201' AND '20251218'
       - For "recent", "latest", "today", "last" queries → use last 2 days
       - For "yesterday" → use appropriate date
       - For specific date range → convert to dt format
       - ⚠️ NEVER query without dt filter unless explicitly asked for "all time" data
    9. If 'datetime' column exists alongside 'dt', use 'dt' for filtering (faster) and 'datetime' for display
    10. Example optimized query:
        SELECT * FROM orders WHERE dt >= '20251201' AND status = 'completed' LIMIT 100
        yesterday = (datetime.now() - timedelta(days=1)).strftime('%Y%m%d')  -> Yesterday's dt=yesterday

    Format your response as:
    SQL: [your SQL query here]
    EXPLANATION: [brief explanation including JOIN strategy if applicable]

  insights_generation: |
    Analyze query results and generate actionable insights.

    Available Information:
    - User Question: {user_question}
    - SQL Query: {sql_query}
    - Data Sample: {data_preview}
    - Schema: {schema_info}

    Generate 1-3 key insights that are:
    1. Actionable and specific
    2. Based on actual data patterns
    3. Relevant to the user's question
    4. Easy to understand

    Identify patterns such as:
    - Trends (increasing/decreasing over time)
    - Anomalies (unexpected values, outliers)
    - Recommendations (what action to take)
    - Summaries (key takeaways)

    Format each insight as:
    TYPE: trend/anomaly/recommendation/summary
    SEVERITY: low/medium/high
    MESSAGE: <concise, actionable insight>

  ops_insights_generation: |
    You are a BigQuery cost and performance expert. Analyze the operational data below and generate concise, actionable insights.

    Operation: {user_question}
    Total rows: {row_count}
    Columns: {columns}

    Data sample:
    {data_preview}

    Generate 4-5 key insights that highlight:
    - Cost savings opportunities or risks
    - Performance anomalies or bottlenecks
    - Security or governance concerns
    - Concrete next steps the team can take

    Respond ONLY with a JSON array, no other text:
    ```json
    [
      {{
        "type": "trend|anomaly|recommendation|summary",
        "icon": "📈|📉|⚠️|💰|🔒|🚀|💡|📊",
        "severity": "info|success|warning",
        "message": "<actionable insight, max 120 chars>"
      }}
    ]
    ```

    JSON: