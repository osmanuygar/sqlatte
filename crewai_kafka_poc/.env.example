APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8001

# Kafka connection
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_TIMEOUT_SECONDS=5
KAFKA_ALLOW_MOCK_FALLBACK=true
MOCK_TOPICS_CSV=orders.created,orders.updated,payments.received,inventory.adjusted,customer.notifications

# CrewAI controls
CREWAI_ENABLED=true
DEFAULT_WORKFLOW_QUESTION=Create a short operational summary and identify potential high-risk topics.
CREWAI_LLM_MODEL=anthropic/claude-3-5-sonnet-latest

# Recommended for Claude
ANTHROPIC_API_KEY=replace-with-your-key

# Optional alternatives
# OPENAI_API_KEY=replace-with-your-key
# GEMINI_API_KEY=replace-with-your-key
