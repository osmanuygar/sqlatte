# Template only — do NOT apply this file or commit it with real values.
# Create it for real with:
#
#   kubectl create secret generic postgres-credentials \
#     --namespace sqlatte \
#     --from-literal=POSTGRES_PASSWORD='<superuser-password>' \
#     --from-literal=SQLATTE_APP_PASSWORD='<app-role-password>'
#
# POSTGRES_PASSWORD is the Postgres superuser password (used once, at first
# boot, to create the app role + databases via 02-postgres-init-configmap.yaml).
# SQLATTE_APP_PASSWORD is what actually goes into config.yaml's
# analytics.postgresql.password / config_db.postgresql.password —
# use the SAME value there and here.

apiVersion: v1
kind: Secret
metadata:
  name: postgres-credentials
  namespace: sqlatte
type: Opaque
stringData:
  POSTGRES_PASSWORD: "change-me-superuser"
  SQLATTE_APP_PASSWORD: "change-me-app-password"
