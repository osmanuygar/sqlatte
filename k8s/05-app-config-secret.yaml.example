# Template only — do NOT apply this file or commit it with real values.
#
# config.yaml commonly contains real credentials (LLM api_key, warehouse DB
# password, SMTP password, ...), so it goes into a Secret, not a ConfigMap —
# ConfigMaps are plain text in etcd unless the cluster has encryption-at-rest
# configured; Secrets get that by default on most managed clusters.
#
# Preferred way to create it (never hand-edit a values field and `kubectl
# apply` it — that leaves the plaintext content in your shell history/an
# unencrypted file on disk):
#
#   kubectl create secret generic sqlatte-config \
#     --namespace sqlatte \
#     --from-file=config.yaml=./config/config.yaml
#
# If config_db is enabled (see README "Encrypted Configuration Storage"),
# config.yaml itself can be secret-free — in that case this Secret only
# needs to carry the config_db bootstrap connection + CONFIG_DB_ENCRYPTION_KEY,
# which is the cleanest setup for a cluster deployment.
#
# In-cluster Postgres (01/03/04-postgres-*.yaml) — point both
# analytics.postgresql and config_db.postgresql at it:
#   host: postgres.sqlatte.svc.cluster.local
#   port: 5432
#   user: sqlatte_app
#   password: <same value as SQLATTE_APP_PASSWORD in 01-postgres-secret.yaml.example>
#   database: sqlatte_analytics   # or sqlatte_config, respectively

apiVersion: v1
kind: Secret
metadata:
  name: sqlatte-config
  namespace: sqlatte
type: Opaque
stringData:
  config.yaml: |
    # paste the real config/config.yaml content here only if creating this
    # resource by hand instead of via `kubectl create secret --from-file`
